{
  "name": "@emiliosp/pi-maestro",
  "version": "0.12.0",
  "description": "A spec-driven multiagent development workflow for Pi.",
  "keywords": [
    "orchestration",
    "pi",
    "pi-coding-agent",
    "pi-package",
    "subagents",
    "workflow"
  ],
  "homepage": "https://github.com/emiliosp/pi-maestro#readme",
  "bugs": {
    "url": "https://github.com/emiliosp/pi-maestro/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emiliosp/pi-maestro.git"
  },
  "files": [
    "extensions/",
    "agents/",
    "templates/",
    "src/",
    "!**/*.test.ts",
    "docs/",
    "MISSION.md",
    "TECH_STACK.md",
    "CHANGELOG.md",
    "ADR.md",
    "README.md",
    "LICENSE"
  ],
  "os": [
    "darwin"
  ],
  "type": "module",
  "imports": {
    "#config/*": "./src/config/*",
    "#specs/*": "./src/specs/*",
    "#artifacts/*": "./src/artifacts/*",
    "#workflow/*": "./src/workflow/*",
    "#maestro/*": "./src/maestro/*",
    "#tools/*": "./src/tools/*",
    "#utils/*": "./src/utils/*",
    "#MaestroPaths.ts": "./src/MaestroPaths.ts",
    "#ids/*": "./src/ids/*",
    "#*": "./*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage --config vitest.config.ts",
    "check": "npm run fmt && npm run lint && npm run typecheck && npm test",
    "prepublishOnly": "npm run check",
    "publish:npm": "npm publish --access public",
    "fmt": "oxfmt",
    "lint": "oxlint --fix"
  },
  "dependencies": {
    "pi-subagents": "0.78.0"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.0.3",
    "@earendil-works/pi-tui": "1.0.3",
    "@types/node": "26.6.4",
    "@vitest/coverage-v8": "5.0.3",
    "oxfmt": "0.73.0",
    "oxlint": "1.87.0",
    "oxlint-anti-slop": "0.3.8",
    "typebox": "1.3.35",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "bundleDependencies": [
    "pi-subagents"
  ],
  "engines": {
    "node": ">=26.0.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  },
  "pi": {
    "extensions": [
      "./extensions/maestro.ts"
    ],
    "subagents": {
      "agents": [
        "./agents"
      ]
    }
  }
}
